# Copy to triageai-backend/.env (never commit .env). These are read only by the backend.

# Gemini (https://aistudio.google.com/app/apikey). Free tier may use submitted data: demo with SAMPLE documents only.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Groq (https://console.groq.com/keys): fallback for text explanations when Gemini is rate-limited
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Leave unset to use triageai-backend/data/triageai.db
# DATABASE_URL=sqlite+aiosqlite:///./triageai.db

# Comma-separated frontend origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for Vercel preview URLs
# CORS_ORIGIN_REGEX=^https://medyphas-ai-.*\.vercel\.app$

# JWT signing secret. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Demo accounts (dr_strange, patient_demo) created on startup
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=password123
